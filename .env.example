# ──────────────────────────────────────────────────────────────
# NEET AI Platform — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ──────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project-id:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-id:password@host:5432/postgres

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=300

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your-strong-random-secret-min-32-chars
JWT_EXPIRY=7d

# ── Storage ───────────────────────────────────────────────────
STORAGE_BUCKET=neet-ai-platform
MAX_UPLOAD_SIZE_MB=20

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AI_THROTTLE_LIMIT=10

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_AI_TUTOR=false
FEATURE_ADAPTIVE_TEST=false
FEATURE_LEADERBOARD=false
FEATURE_VOICE_MODE=false
FEATURE_OWN_PAPER_MODE=true
FEATURE_YOUTUBE_RAG=false